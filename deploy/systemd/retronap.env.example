# H2 database basename: omit the .mv.db extension.
RETRONAP_FILE_DATABASE=/var/lib/retronap/retronap

# Use the existing database credentials when migrating a database file.
RETRONAP_FILE_DATABASE_USERNAME=sa
RETRONAP_FILE_DATABASE_PASSWORD=

# For remote clients, uncomment and replace with the VPS's reachable address.
# RETRONAP_METASERVER_SERVERLIST=203.0.113.10:8888
